
install.packages("ggplot2")
library(ggplot2)

dna <- "ATGCGATCGTAGCTAGCTAG"
bases <- strsplit(dna, "")[[1]]

# Count nucleotides
counts <- as.data.frame(table(bases))
colnames(counts) <- c("Nucleotide", "Frequency")

# Bar plot
ggplot(counts, aes(x=Nucleotide, y=Frequency,
                   fill=Nucleotide)) +
  geom_col() +
  labs(title="DNA Nucleotide Frequency",
       x="Nucleotide",
       y="Count") +
  theme_minimal()

# GC and AT content
gc <- sum(bases %in% c("G", "C"))
at <- sum(bases %in% c("A", "T"))

content <- data.frame(
  Type=c("GC Content", "AT Content"),
  Percentage=c(gc, at)/length(bases)*100
)

# Pie chart
ggplot(content, aes(x="", y=Percentage,
                    fill=Type)) +
  geom_col(width=1) +
  coord_polar("y") +
  labs(title="GC vs AT Content") +
  theme_void()

